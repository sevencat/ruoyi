        <Nullable>disable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>sevencat.ruoyi</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Autofac.Extensions.DependencyInjection" Version="11.0.2" />
        <PackageReference Include="dotenv.net" Version="4.1.0" />
        <PackageReference Include="FreeRedis" Version="1.5.5" />
